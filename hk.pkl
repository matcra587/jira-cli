// clover: from=hk find=download/v<version>/hk@<version>
amends "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Config.pkl"
// clover: from=hk find=download/v<version>/hk@<version>
import "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Builtins.pkl"

min_hk_version = "1.44.0"

local gofumpt = (Builtins.go_fumpt) {
    check = "test -z \"$(go tool gofumpt -l {{ files }})\""
    fix = "go tool gofumpt -w {{ files }}"
}

local golangciLint = (Builtins.golangci_lint) {
    check = "cd {{workspace}} && golangci-lint run --fix=false ./..."
    fix = "cd {{workspace}} && golangci-lint run --fix ./..."
    depends = List("gofumpt")
}

local govulncheck = (Builtins.go_vuln_check) {
    check = "cd {{workspace}} && go tool govulncheck ./..."
}

local linters = new Mapping<String, Step> {
    ["gofumpt"] = gofumpt
    ["go-vet"] = Builtins.go_vet
    ["golangci-lint"] = golangciLint
    ["rumdl"] = (Builtins.rumdl) {
        // docs/reference/ is generated at build time and gitignored, but the hk
        // rumdl builtin globs the working tree (not git), so exclude the raw
        // gh-style pages (hard tabs, language-less fences) it would otherwise
        // try to reformat.
        exclude = "docs/reference/**"
    }
    ["actionlint"] = Builtins.actionlint
    ["zizmor"] = Builtins.zizmor
    // Honors BETTERLEAKS_CONFIG, so user-level rule extensions apply on top
    // of the default secret rules without living in the repo.
    ["betterleaks"] = Builtins.betterleaks
}

local linters_with_security = (linters) {
    ["govulncheck"] = (govulncheck) { exclusive = true }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps = linters_with_security
    }
    ["check"] {
        steps = linters_with_security
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["commit-msg"] {
        steps {
            ["conventional"] = Builtins.check_conventional_commit
            ["betterleaks"] = new Step {
                check = "betterleaks stdin --no-banner < {{commit_msg_file}}"
            }
            // A feat/fix must ship a changie fragment (or an explicit
            // `Changelog: skip` trailer) so nothing user-facing is missed from
            // the release notes. Routed through the mise task (a cross-platform
            // Go program — see tasks.toml) so it stays discoverable in
            // `mise tasks`.
            ["check-changie"] = new Step {
                check = "mise run check-changie {{commit_msg_file}}"
            }
        }
    }
}
