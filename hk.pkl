// clover: from=hk find=download/v<version>/hk@<version>
amends "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Config.pkl"
// clover: from=hk find=download/v<version>/hk@<version>
import "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Builtins.pkl"

min_hk_version = "2.8.1"

local gofumptTestEnv = new Mapping<String, String> {
    ["GOWORK"] = "off"
    ["GOTOOLCHAIN"] = "local"
    ["GOPROXY"] = "off"
}

// gofumpt lives in go.mod's tools block, so every inherited command must use
// `go tool`, including the probes hk prefers before fixing. The launcher can
// populate Go's build cache; declare that effect even for source-only checks.
// Capture failures explicitly because gofumpt -l exits 0 for unformatted files.
local gofumpt = (Builtins.go_fumpt) {
    check = new CommandSpec {
        command = "out=\"$(go tool gofumpt -l {{ files }})\" || exit 1; test -z \"$out\""
        effect = "write"
    }
    check_diff = new CommandSpec {
        command = new Command {
            argv = List("go", "tool", "gofumpt", "-d", "{{files}}")
        }
        effect = "write"
    }
    check_list_files = new CommandSpec {
        command = "out=\"$(go tool gofumpt -l {{ files }})\" || exit 1; if [ -n \"$out\" ]; then printf '%s\\n' \"$out\"; exit 1; fi"
        effect = "write"
    }
    fix = new CommandSpec {
        command = new Command {
            argv = List("go", "tool", "gofumpt", "-w", "{{files}}")
        }
        effect = "write"
    }
    // The builtin's sandboxes contain only test.go. Include the selected tool
    // manifest so native tests exercise the same formatter as the real hook.
    tests = new Mapping<String, StepTest> {
        for (name, test in Builtins.go_fumpt.tests) {
            [name] = (test) {
                files = List("test.go")
                write {
                    ["go.mod"] = read("go.mod").text
                    ["go.sum"] = read("go.sum").text
                }
                env = gofumptTestEnv
            }
        }
        ["malformed file fails"] {
            tmpdir = true
            files = List("test.go")
            write {
                ["go.mod"] = read("go.mod").text
                ["go.sum"] = read("go.sum").text
                ["test.go"] = "package name\nfunc (\n"
            }
            env = gofumptTestEnv
            expect {
                code = 1
                stderr = "expected"
            }
        }
        ["missing tool fails"] {
            tmpdir = true
            files = List("test.go")
            write {
                ["go.mod"] = "module example.com/formatter-test\ngo 1.24\n"
                ["test.go"] = "package name\n"
            }
            env = gofumptTestEnv
            expect {
                code = 1
                stderr = "no such tool"
            }
        }
    }
}

// The builtin already runs `cd {{workspace}} && golangci-lint run ./...`;
// only the ordering against gofumpt is ours.
local golangciLint = (Builtins.golangci_lint) {
    depends = List("gofumpt")
}

local linters = new Mapping<String, Step> {
    ["gofumpt"] = gofumpt
    ["go-vet"] = Builtins.go_vet
    ["golangci-lint"] = golangciLint
    ["rumdl"] = (Builtins.rumdl) {
        // docs/reference/ is generated at build time and gitignored, but the hk
        // rumdl builtin globs the working tree (not git), so exclude the raw
        // gh-style pages (hard tabs, language-less fences) it would otherwise
        // try to reformat.
        exclude = "docs/reference/**"
    }
    ["actionlint"] = Builtins.actionlint
    ["zizmor"] = Builtins.zizmor
    // Honors BETTERLEAKS_CONFIG, so user-level rule extensions apply on top
    // of the default secret rules without living in the repo.
    ["betterleaks"] = Builtins.betterleaks
}

local linters_with_security = (linters) {
    // `go tool` because govulncheck lives in go.mod's tools block, not PATH.
    ["govulncheck"] = (Builtins.go_vuln_check) {
        check = "cd {{workspace}} && go tool govulncheck ./..."
        exclusive = true
    }
}

// A deliberate local brake on publishing. `touch .no-push` in a worktree
// that must not reach the remote yet — an in-flight rewrite, a branch
// waiting on sign-off, a history rebase mid-flight — and every push from
// it stops here.
//
// The mechanism is tracked so every clone has it; the DECISION is an
// untracked marker file, so arming it stays local and never lands on
// anyone else. Git's own `branch.<name>.pushRemote = no_push` guards only
// a bare `git push`: naming a remote (`git push origin HEAD`) walks
// straight past it, which is exactly what muscle memory types. A hook
// sees every form.
//
// Exclusive so it lands before the linters spend a minute on a push that
// was never going to happen. Remove the marker to publish.
local noPush = new Step {
    check = "test ! -f .no-push || { echo 'hk: refusing to push — .no-push marker present in this worktree; remove it to publish'; exit 1; }"
    exclusive = true
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps = linters
    }
    ["pre-push"] {
        steps = (linters_with_security) {
            ["no-push"] = noPush
        }
    }
    ["check"] {
        steps = linters_with_security
    }
    ["fix"] {
        fix = true
        steps = linters
    }
    ["commit-msg"] {
        steps {
            ["conventional"] = Builtins.check_conventional_commit
            ["betterleaks"] = new Step {
                check = "betterleaks stdin --no-banner < {{commit_msg_file}}"
            }
            // A feat/fix must ship a changie fragment (or an explicit
            // `Changelog: skip` trailer) so nothing user-facing is missed from
            // the release notes. Routed through the mise task (a cross-platform
            // Go program — see tasks.toml) so it stays discoverable in
            // `mise tasks`.
            ["check-changie"] = new Step {
                check = "mise run check-changie {{commit_msg_file}}"
            }
        }
    }
}
