# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Local environment and secrets
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Go
vendor/
*.exe
*.test
*.out
coverage.out
# Stray `go build` at repo root without -o lands the binary at /jira;
# ignore it so an accidental `git add -A` can't commit it.
/jira

# Builds and releases
bin/
dist/
build/
out/

# The docs/ site is part of the repo; re-include it in case a developer has a
# broad personal docs/ ignore rule. The superpowers/ rollout scaffolding under
# it is local-only and stays ignored.
!docs/
docs/superpowers/
# The command reference is generated at site-build time and published straight
# to Pages — never committed. The generator is pruned until it is rebuilt for
# the current command tree; the ignore stays so a rebuild can't commit output.
docs/reference/

# Local overrides
*.local.*
.task/

# Zensical site build output (uvx --from zensical zensical build)
site/
.claude.local.md
