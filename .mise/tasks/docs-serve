#!/usr/bin/env bash
# Serve the docs site locally with live reload.
#
# Serves the committed zensical.toml directly — no throwaway config is written,
# so nothing lands in the working tree. site_url stays the production URL, which
# means instant navigation falls back to full page loads locally; links still
# work. Args pass through: add `--dev-addr 0.0.0.0:8000` to reach it from a
# phone on the LAN, or `-o` to open a browser.
set -euo pipefail
# clover: from=zensical
exec uvx --from zensical==0.0.60 zensical serve -f zensical.toml "$@"
