#!/usr/bin/env bash
# [MISE] description="Print build version info"
# [MISE] quiet=true
# [USAGE] unknown_flags "error"
# [USAGE] flag "-h --help" help="Show task help"
set -euo pipefail

# shellcheck source=.mise/tasks/lib/build-env.sh
source .mise/tasks/lib/build-env.sh

cat <<EOF
Version:    $(jira_version)
Branch:     $(jira_branch)
Built by:   $(jira_build_by)
Go version: $(go version)
EOF
